    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ES2019"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "vite.config.mts"],
  "exclude": ["dist", "node_modules"]
}
