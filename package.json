{
  "name": "source-pane",
  "version": "3.1.1-1",
  "description": "Solid-compatible Panes: Source editor",
  "main": "dist/index.cjs.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "/dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && vite build",
    "watch": "vite build --watch",
    "lint": "eslint",
    "lint-fix": "eslint --fix",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "prepublishOnly": "npm run test && npm run build",
    "preversion": "npm run lint && npm test",
    "start": "vite"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolidOS/source-pane.git"
  },
  "keywords": [
    "solid",
    "source",
    "decentralized",
    "web",
    "rdf",
    "ldp",
    "linked",
    "pane",
    "app",
    "data"
  ],
  "author": "Tim Berners-Lee <timbl@mit.edu>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SolidOS/source-pane/issues"
  },
  "homepage": "https://github.com/SolidOS/source-pane",
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "jsdom": "^28.1.0",
    "pane-registry": "3.1.2-1",
    "rdflib": "2.4.0",
    "solid-logic": "4.0.8-1",
    "solid-ui": "3.1.3-9",
    "solidos-toolkit": "dev"
  },
  "dependencies": {
    "vite": "^8.0.16",
    "vitest": "^4.0.18",
    "vitest-axe": "^0.1.0"
  },
  "solidosDependencies": [
    "rdflib",
    "solid-logic",
    "pane-registry",
    "solid-ui"
  ]
}
