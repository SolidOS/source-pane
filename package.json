{
  "name": "source-pane",
  "version": "4.0.0-0",
  "description": "Solid-compatible Panes: Source editor",
  "main": "dist/index.cjs.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "/dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "src/components/**/*.ts"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run typecheck && npm run clean && vite build",
    "typecheck": "tsc --noEmit",
    "watch": "vite build --watch",
    "lint": "eslint",
    "lint-fix": "eslint --fix",
    "test": "npm run typecheck-test && vitest run",
    "test-coverage": "vitest run --coverage",
    "typecheck-test": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run test && npm run build",
    "preversion": "npm run lint && npm test",
    "start": "vite"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolidOS/source-pane.git"
  },
  "keywords": [
    "solid",
    "source",
    "decentralized",
    "web",
    "rdf",
    "ldp",
    "linked",
    "pane",
    "app",
    "data"
  ],
  "author": "Tim Berners-Lee <timbl@mit.edu>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SolidOS/source-pane/issues"
  },
  "homepage": "https://github.com/SolidOS/source-pane",
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.116",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^28.1.0",
    "mime-types": "^3.0.2",
    "solidos-toolkit": "dev",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "@typescript-eslint/parser": "^8.63.0",
    "lit": "^3.3.3",
    "pane-registry": "5.0.0-0",
    "rdflib": "2.4.0",
    "solid-logic": "6.0.0-0",
    "solid-ui": "5.0.0-1",
    "vite": "^8.0.16",
    "vitest": "^4.0.18",
    "vitest-axe": "^0.1.0"
  },
  "solidosDependencies": [
    "rdflib",
    "solid-logic",
    "pane-registry",
    "solid-ui"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
